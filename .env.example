# 1이면 Claude를 부르지 않고 샘플 계약서로 응답 (API 키 없이 화면 개발)
MOCK_AI=0

# [방법 A] Anthropic 키를 직접 쓸 때
ANTHROPIC_API_KEY=

# [방법 B] OpenRouter를 쓸 때: 아래 세 줄을 채우고 ANTHROPIC_API_KEY는 비워 둔다
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=sk-or-v1-...
# CLAUDE_MODEL=anthropic/claude-opus-5.5

# 카카오 로그인 (developers.kakao.com → 내 애플리케이션)
# REST API 키, 보안 메뉴의 Client Secret. Redirect URI는 {사이트 주소}/api/auth/kakao/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 로그인 쿠키 서명용 비밀값, 32자 이상. 만들기: openssl rand -base64 32
SESSION_SECRET=
